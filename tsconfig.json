{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node",
      "react",
      "react-native"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    "tests/**/*.ts",
    "mock-server/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web-dist",
    "native-dist"
  ]
}
